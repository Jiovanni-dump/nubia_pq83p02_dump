#
#silead fingerprint
#
on post-fs-data
    chown system system /dev/silead_fp
    chmod 0770 /dev/silead_fp
    mkdir /data/system/silead
    chown system system /data/system/silead
    chmod 0770 /data/system/silead
    mkdir /data/vendor/silead
    chown system system /data/vendor/silead
    chmod 0777 /data/vendor/silead

on boot
    chown system system /dev/silead_fp
    chmod 0770 /dev/silead_fp
    mkdir /data/system/silead
    chown system system /data/system/silead
    chmod 0770 /data/system/silead
    mkdir /data/vendor/silead
    chown system system /data/vendor/silead
    chmod 0777 /data/vendor/silead


service vendor.fps_hal /vendor/bin/hw/android.hardware.biometrics.fingerprint.aidl-service
    class late_start
    user system
    group system input
    #writepid /dev/cpuset/top-app/tasks
    task_profiles MaxPerformance
    disabled

service ztecmdaidl /vendor/bin/hw/vendor.zte.fingerprint.ztecmdaidl-service
   class late_start
   user system
   group system input uhid
   #writepid /dev/cpuset/top-app/tasks
   task_profiles MaxPerformance
   #disabled

on property:vendor.fingerprint.id=null
   stop ztecmdaidl
