			enable-method = "psci";
			cpu-idle-states = <0x0c 0x0d>;
			power-domains = <0x0e>;
			power-domain-names = "psci";
			capacity-dmips-mhz = <0x69a>;
			dynamic-power-coefficient = <0x11f>;
			next-level-cache = <0x0f>;
			phandle = <0x1d>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x08>;
				phandle = <0x0f>;
